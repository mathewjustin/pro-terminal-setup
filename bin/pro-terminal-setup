#!/usr/bin/env sh
set -eu

prefix="${PRO_TERMINAL_PREFIX:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
home="${HOME:?HOME is not set}"

managed_files="
$home/.config/pro-terminal/zsh.zsh
$home/.config/pro-terminal/intro.sh
$home/.config/pro-terminal/Brewfile
$home/.config/starship.toml
$home/.config/ghostty/config.ghostty
$home/.tmux.conf
$home/.local/bin/terminal-intro
"

install_file() {
  src="$1"
  dst="$2"
  mkdir -p "$(dirname -- "$dst")"
  if [ -e "$dst" ] && ! cmp -s "$src" "$dst"; then
    backup="$dst.backup.$(date +%Y%m%d%H%M%S)"
    cp "$dst" "$backup"
    printf 'Backed up %s to %s\n' "$dst" "$backup"
  fi
  cp "$src" "$dst"
}

backup_files() {
  backup_dir="$home/.config/pro-terminal/backups/$(date +%Y%m%d%H%M%S)-$$"
  mkdir -p "$backup_dir"
  copied=0
  for file in $managed_files "$home/.zshrc"; do
    if [ -e "$file" ]; then
      rel="$(printf '%s' "$file" | sed "s|^$home/||")"
      mkdir -p "$backup_dir/$(dirname -- "$rel")"
      cp "$file" "$backup_dir/$rel"
      copied=$((copied + 1))
    fi
  done
  printf 'Backed up %s file(s) to %s\n' "$copied" "$backup_dir"
}

append_source_line() {
  zshrc="$home/.zshrc"
  line='[ -f "$HOME/.config/pro-terminal/zsh.zsh" ] && source "$HOME/.config/pro-terminal/zsh.zsh"'
  touch "$zshrc"
  if ! grep -Fq "$line" "$zshrc"; then
    {
      printf '\n'
      printf '# Pro terminal setup\n'
      printf '%s\n' "$line"
    } >> "$zshrc"
    printf 'Updated %s\n' "$zshrc"
  else
    printf '%s already sources pro-terminal.\n' "$zshrc"
  fi
}

remove_source_line() {
  zshrc="$home/.zshrc"
  line='[ -f "$HOME/.config/pro-terminal/zsh.zsh" ] && source "$HOME/.config/pro-terminal/zsh.zsh"'
  [ -f "$zshrc" ] || return 0
  tmp="$zshrc.tmp.$$"
  grep -Fv "$line" "$zshrc" | grep -Fv '# Pro terminal setup' > "$tmp" || true
  mv "$tmp" "$zshrc"
  printf 'Removed pro-terminal source line from %s\n' "$zshrc"
}

case "${1:-install}" in
  install)
    backup_files
    install_file "$prefix/config/pro-terminal/zsh.zsh" "$home/.config/pro-terminal/zsh.zsh"
    install_file "$prefix/config/pro-terminal/intro.sh" "$home/.config/pro-terminal/intro.sh"
    install_file "$prefix/config/pro-terminal/Brewfile" "$home/.config/pro-terminal/Brewfile"
    install_file "$prefix/config/starship/starship.toml" "$home/.config/starship.toml"
    install_file "$prefix/config/ghostty/config.ghostty" "$home/.config/ghostty/config.ghostty"
    install_file "$prefix/config/tmux.conf" "$home/.tmux.conf"
    if command -v zsh >/dev/null 2>&1; then
      zsh_path="$(command -v zsh)"
      tmp_tmux="$home/.tmux.conf.tmp.$$"
      awk -v shell="$zsh_path" '
        /^set -g default-shell / { print "set -g default-shell " shell; next }
        /^set -g default-command / { print "set -g default-command " shell; next }
        { print }
      ' "$home/.tmux.conf" > "$tmp_tmux"
      mv "$tmp_tmux" "$home/.tmux.conf"
    fi
    chmod +x "$home/.config/pro-terminal/intro.sh"
    mkdir -p "$home/.local/bin"
    cat > "$home/.local/bin/terminal-intro" <<'INTRO'
#!/usr/bin/env sh
exec "$HOME/.config/pro-terminal/intro.sh" "$@"
INTRO
    chmod +x "$home/.local/bin/terminal-intro"
    append_source_line
    printf '\nInstalled pro terminal setup.\n'
    printf 'Open a new terminal, then run: terminal-intro\n'
    ;;
  backup)
    backup_files
    ;;
  doctor)
    for cmd in ghostty zsh starship zoxide eza bat fd rg fzf kubectl k9s tmux; do
      if command -v "$cmd" >/dev/null 2>&1; then
        printf 'ok   %s -> %s\n' "$cmd" "$(command -v "$cmd")"
      else
        printf 'miss %s\n' "$cmd"
      fi
    done
    ;;
  uninstall)
    backup_files
    remove_source_line
    for file in $managed_files; do
      if [ -e "$file" ]; then
        rm -f "$file"
        printf 'Removed %s\n' "$file"
      fi
    done
    printf '\nUninstalled pro terminal setup files. Backups were kept.\n'
    ;;
  *)
    printf 'Usage: pro-terminal-setup [install|doctor|backup|uninstall]\n' >&2
    exit 2
    ;;
esac
